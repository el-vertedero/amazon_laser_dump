    chown ledcontroller ledcontroller /sys/class/leds/lp5036:ledmod_22/red
    chown ledcontroller ledcontroller /sys/class/leds/lp5036:ledmod_22/green
    chown ledcontroller ledcontroller /sys/class/leds/lp5036:ledmod_22/blue
    chown ledcontroller ledcontroller /sys/class/leds/lp5036:ledmod_22/brightness
    chown ledcontroller ledcontroller /sys/class/leds/lp5036:ledmod_22/trigger
    chown ledcontroller ledcontroller /sys/class/leds/lp5036:ledmod_23/color
