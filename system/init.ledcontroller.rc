# Laser ledcontroller init config

on post-fs
    # On Laser 8512, PWM Channel 6 Controls the LED Brightness PWM
    write /sys/class/pwm/pwmchip0/export "6"

on boot
    chown ledcontroller ledcontroller /sys/class/leds/lp5036:ledmod_0/color
    chown ledcontroller ledcontroller /sys/class/leds/lp5036:ledmod_0/red
    chown ledcontroller ledcontroller /sys/class/leds/lp5036:ledmod_0/green
