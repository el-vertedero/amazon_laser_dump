    chown ledcontroller ledcontroller /sys/class/leds/lp5036:ledmod_23/blue
    chown ledcontroller ledcontroller /sys/class/leds/lp5036:ledmod_23/brightness
    chown ledcontroller ledcontroller /sys/class/leds/lp5036:ledmod_23/trigger

    # On Laser 8512, PWM Channel 6 Controls the LED Brightness PWM
    chown ledcontroller ledcontroller /sys/class/pwm/pwmchip0/pwm6/period
    chown ledcontroller ledcontroller /sys/class/pwm/pwmchip0/pwm6/duty_cycle
    chown ledcontroller ledcontroller /sys/class/pwm/pwmchip0/pwm6/enable

    # On Laser 8512, ledcontroller needs RW access to ledhven
    chown ledcontroller ledcontroller /sys/class/i2c-dev/i2c-0/device/0-0030/ledhven
    chown ledcontroller ledcontroller /sys/class/i2c-dev/i2c-0/device/0-0031/ledhven

on post-fs-data
   mkdir /data/ledcontroller 0760 ledcontroller ledcontroller
   chown ledcontroller aipc /data/ledcontroller
   chown ledcontroller aipc /system/etc/led_mute_ring_config_1.json
   chown ledcontroller aipc /system/etc/led_mute_ring_config_2.json
   chown --reference=/system/etc/led_mute_ring_config.json /data/ledcontroller/led_mute_ring_config.json

on property:ledcontroller.restart=1
    restart ledcontroller

