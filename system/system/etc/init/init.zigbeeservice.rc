on property:wlan.driver.status=ok
    start zigbeeservice

service zigbeeservice /system/bin/ace_zigbee_service
    class main
    setenv LD_LIBRARY_PATH /system/local/zigbee
    user zigbee
    group aipc zigbee dbus ace_kvstore ace_group ace_maplite inet
    disabled
