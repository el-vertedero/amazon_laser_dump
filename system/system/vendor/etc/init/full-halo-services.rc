#svc hub broker
service halo-hub-broker /vendor/bin/psbroker
   user system
   group root system inet net_admin shell log
   disabled

#svc hub core
service halo-hub-core /vendor/bin/hub-core
   user system
   group root system inet net_admin shell log
   disabled

#Metrics reporter and log rotation service
service halo-logr /vendor/bin/halo_logr "--uploader.server=${vendor.halo.server}" "--uploader.env=${vendor.halo.env}" "--uploader.device_id=${vendor.halo.ringnetid}" "--uploader.device_kind=${ro.product.config.type}" "--uploader.sdk_version=${vendor.halo.version}" "--uploader.serial=${vendor.halo.serial}" "--uploader.auth_token=${vendor.halo.authtoken}" "--uploader.firmware_version=${ro.build.version.number}"
   user system
   group root system inet net_admin shell log
   disabled

#svc core plugins
service halo-core-rnp /vendor/bin/core-plugin-loader --loader.plugin_path="/vendor/lib/cp_ringnet.so"
   user system
   group root system inet net_admin shell log
   disabled

service halo-core-swp /vendor/bin/cp_sidewalk
   user system
   group root system inet net_admin shell log aipc ace_maplite ace_group dbus keystore ace_kvstore
   disabled

service halo-init /vendor/bin/init_full_halo_services.sh
   user system
   group root system inet net_admin shell
   oneshot
   disabled

service halo-prop-init /vendor/bin/init_halo_metrics.sh
   user system
   group root system inet net_admin shell
   oneshot
   disabled

service halo-regiond /vendor/bin/halo_regiond
   user system
   group root system inet net_admin shell aipc ace_kvstore ace_group
   oneshot
   disabled

service halo-check /vendor/bin/init_full_halo_services.sh check
   user system
   group root system inet net_admin shell
   oneshot
   disabled

service halo-init-prov /vendor/bin/init_full_halo_services.sh prov
   user system
   group root system inet net_admin shell
   oneshot
   disabled

service halo-otamgr /vendor/bin/halo_otamgr
   user system
   group root system inet net_admin shell log
   oneshot
   disabled

service halo-sendlogs /vendor/bin/sendlogs.sh
   user system
   group root system inet net_admin shell log
   oneshot
   disabled

service halo-ota-exit /vendor/bin/halo_ota_exit.sh
   user system
   group root system inet net_admin shell
   oneshot
   disabled

service halo-config /vendor/bin/init_full_halo_services.sh config
   user system
   group root system inet net_admin shell
   oneshot
   disabled

service halofwlog /vendor/bin/halofw-log.sh
   user system
   group root system inet net_admin shell
   disabled

service halo-bssid-scan /vendor/bin/halo_bssid_scan
   user system
   group root system inet net_admin shell aipc ace_group
   oneshot
   disabled

on post-fs-data && property:vold.decrypt=trigger_post_fs_data
   export SETUP_DOC_PATH /vendor/usr/share/zdk/setup-docs/
   export CONFUSER_ROOT /mnt/halo/etc

   mkdir /data/vendor 0770 system system
   mkdir /data/vendor/halo 0770 system system
   mkdir /data/vendor/halo/var 0770 system system
   mkdir /data/vendor/halo/var/log 0770 system system
   mkdir /data/vendor/halo/var/log/core-plugins 0770 system system
   mkdir /data/vendor/halo/var/log/zservice 0770 system system
   mkdir /data/vendor/halo/var/sqlite 0770 system system
   mkdir /data/vendor/halo/var/metrics_reporter 0770 system system
   mkdir /data/vendor/halo/var/rsl_ringnet_metrics 0770 system system
   mkdir /data/vendor/halo/var/run 0770 system system
   mkdir /data/vendor/halo/var/run/hub-core 0770 system system

   mkdir /data/vendor/halo/run 0770 system system
   mkdir /data/vendor/halo/run/mfg 0770 system system
   mkdir /data/vendor/halo/run/ras-hosts 0770 system system
   mkdir /data/vendor/halo/etc 0770 system system
   mkdir /data/vendor/halo/etc/maintainer 0770 system system

   mkdir /mnt/halo 0770 system system
   mkdir /mnt/halo/run 0770 system system
   mkdir /mnt/halo/run/mfg 0770 system system
   mkdir /mnt/halo/run/ras-hosts 0770 system system

   mkdir /mnt/halo/etc 0770 system system
   mkdir /mnt/halo/etc/core-plugins 0770 system system
   mkdir /mnt/halo/etc/core-plugins/ringnet.conf.d 0770 system system
   mkdir /mnt/halo/etc/core-plugins/sidewalk.conf.d 0770 system system
   mkdir /mnt/halo/etc/hub-core.conf.d 0770 system system
   mkdir /mnt/halo/etc/core-messaging-bridge.conf.d 0770 system system
   mkdir /mnt/halo/etc/las-broker 0770 system system
   mkdir /mnt/halo/etc/maintainer 0770 system system
   mkdir /mnt/halo/etc/update_lights.conf.d 0770 system system
   mkdir /mnt/halo/etc/halo_logr.conf.d 0770 system system
   mkdir /mnt/halo/etc/halo_regiond.conf.d 0770 system system

   mkdir /data/vendor/halo/tmp 0770 system system
   mkdir /data/vendor/halo/tmp/dfu 0770 system system

   start halo-config

on post-fs-data && property:ro.crypto.state=unencrypted
   export SETUP_DOC_PATH /vendor/usr/share/zdk/setup-docs/
   export CONFUSER_ROOT /mnt/halo/etc

   mkdir /data/vendor 0770 system system
   mkdir /data/vendor/halo 0770 system system
   mkdir /data/vendor/halo/var 0770 system system
   mkdir /data/vendor/halo/var/log 0770 system system
   mkdir /data/vendor/halo/var/log/core-plugins 0770 system system
   mkdir /data/vendor/halo/var/log/zservice 0770 system system
   mkdir /data/vendor/halo/var/sqlite 0770 system system
   mkdir /data/vendor/halo/var/metrics_reporter 0770 system system
   mkdir /data/vendor/halo/var/rsl_ringnet_metrics 0770 system system
   mkdir /data/vendor/halo/var/run 0770 system system
   mkdir /data/vendor/halo/var/run/hub-core 0770 system system

   mkdir /data/vendor/halo/run 0770 system system
   mkdir /data/vendor/halo/run/mfg 0770 system system
   mkdir /data/vendor/halo/run/ras-hosts 0770 system system
   mkdir /data/vendor/halo/etc 0770 system system
   mkdir /data/vendor/halo/etc/maintainer 0770 system system

   mkdir /mnt/halo 0770 system system
   mkdir /mnt/halo/run 0770 system system
   mkdir /mnt/halo/run/mfg 0770 system system
   mkdir /mnt/halo/run/ras-hosts 0770 system system

   mkdir /mnt/halo/etc 0770 system system
   mkdir /mnt/halo/etc/core-plugins 0770 system system
   mkdir /mnt/halo/etc/core-plugins/ringnet.conf.d 0770 system system
   mkdir /mnt/halo/etc/core-plugins/sidewalk.conf.d 0770 system system
   mkdir /mnt/halo/etc/hub-core.conf.d 0770 system system
   mkdir /mnt/halo/etc/core-messaging-bridge.conf.d 0770 system system
   mkdir /mnt/halo/etc/las-broker 0770 system system
   mkdir /mnt/halo/etc/maintainer 0770 system system
   mkdir /mnt/halo/etc/update_lights.conf.d 0770 system system
   mkdir /mnt/halo/etc/halo_logr.conf.d 0770 system system
   mkdir /mnt/halo/etc/halo_regiond.conf.d 0770 system system

   mkdir /data/vendor/halo/tmp 0770 system system
   mkdir /data/vendor/halo/tmp/dfu 0770 system system

   start halo-config

on post-fs-data && property:ro.crypto.state=unsupported
   export SETUP_DOC_PATH /vendor/usr/share/zdk/setup-docs/
   export CONFUSER_ROOT /mnt/halo/etc

   mkdir /data/vendor 0770 system system
   mkdir /data/vendor/halo 0770 system system
   mkdir /data/vendor/halo/var 0770 system system
   mkdir /data/vendor/halo/var/log 0770 system system
   mkdir /data/vendor/halo/var/log/core-plugins 0770 system system
   mkdir /data/vendor/halo/var/log/zservice 0770 system system
   mkdir /data/vendor/halo/var/sqlite 0770 system system
   mkdir /data/vendor/halo/var/metrics_reporter 0770 system system
   mkdir /data/vendor/halo/var/rsl_ringnet_metrics 0770 system system
   mkdir /data/vendor/halo/var/run 0770 system system
   mkdir /data/vendor/halo/var/run/hub-core 0770 system system

   mkdir /data/vendor/halo/run 0770 system system
   mkdir /data/vendor/halo/run/mfg 0770 system system
   mkdir /data/vendor/halo/run/ras-hosts 0770 system system
   mkdir /data/vendor/halo/etc 0770 system system
   mkdir /data/vendor/halo/etc/maintainer 0770 system system

   mkdir /mnt/halo 0770 system system
   mkdir /mnt/halo/run 0770 system system
   mkdir /mnt/halo/run/mfg 0770 system system
   mkdir /mnt/halo/run/ras-hosts 0770 system system

   mkdir /mnt/halo/etc 0770 system system
   mkdir /mnt/halo/etc/core-plugins 0770 system system
   mkdir /mnt/halo/etc/core-plugins/ringnet.conf.d 0770 system system
   mkdir /mnt/halo/etc/core-plugins/sidewalk.conf.d 0770 system system
   mkdir /mnt/halo/etc/hub-core.conf.d 0770 system system
   mkdir /mnt/halo/etc/core-messaging-bridge.conf.d 0770 system system
   mkdir /mnt/halo/etc/las-broker 0770 system system
   mkdir /mnt/halo/etc/maintainer 0770 system system
   mkdir /mnt/halo/etc/update_lights.conf.d 0770 system system
   mkdir /mnt/halo/etc/halo_logr.conf.d 0770 system system
   mkdir /mnt/halo/etc/halo_regiond.conf.d 0770 system system

   mkdir /data/vendor/halo/tmp 0770 system system
   mkdir /data/vendor/halo/tmp/dfu 0770 system system

   start halo-config

on property:init.svc.halo-config=stopped
   start halo-hub-broker

on property:init.svc.halo-hub-broker=running
   start halo-bssid-scan

on property:vendor.halo.ready=true
   start halo-init
   start halofwlog

#Daredevil support three network types, so trigger halo-regiond for each network type
on property:init.svc.halo-init=stopped && property:vendor.halo.healthcheck=true && property:dhcp.wlan0.result=ok
   start halo-regiond

on property:init.svc.halo-init=stopped && property:vendor.halo.healthcheck=true && property:dhcp.eth0.result=ok
   start halo-regiond

on property:init.svc.halo-init=stopped && property:vendor.halo.healthcheck=true && property:dhcp.usb0.result=ok
   start halo-regiond

on property:vendor.halo.protocol.enable=true && property:vendor.halo.prov=none && property:vendor.halo.hubcore.config=true
   start halo-hub-core

on property:vendor.halo.protocol.enable=true && property:init.svc.halo-init-prov=stopped && property:vendor.halo.hubcore.config=true
   start halo-hub-core

on property:vendor.halo.protocol.enable=false
   stop halo-core-rnp
   stop halo-hub-core
   stop halo-core-swp
   stop halo-logr

#Start ringnet plugin
on property:init.svc.halo-hub-core=running && property:vendor.halo.enable.ringnet=true && property:vendor.halo.key.refresh=false
   write /mnt/halo/etc/sw_version ${ro.build.version.number}
   chown system system /mnt/halo/etc/sw_version
   chmod 0660 /mnt/halo/etc/sw_version
   start halo-core-rnp

#Start sidewalk plugin
on property:init.svc.halo-logr=running && property:vendor.halo.enable.sidewalk=true && property:vendor.halo.key.refresh=false
   write /mnt/halo/etc/sw_version ${ro.build.version.number}
   chown system system /mnt/halo/etc/sw_version
   chmod 0660 /mnt/halo/etc/sw_version
   write /mnt/halo/run/mfg/gatewayid ${ro.serialno}
   chown system system /mnt/halo/run/mfg/gatewayid
   chmod 0660 /mnt/halo/run/mfg/gatewayid
   start halo-core-swp

#Start metrics-reporter and remove hub-core.pid
on property:init.svc.halo-hub-core=running
   start halo-prop-init
   wait /data/vendor/halo/var/run/hub-core/hub-core.pid 1
   rm /data/vendor/halo/var/run/hub-core/hub-core.pid

#Start metrics-reporter
on property:init.svc.halo-hub-core=running && property:init.svc.halo-prop-init=stopped
   start halo-logr

#Restart core services after provisioning
on property:vendor.halo.core-services=start
   setprop vendor.halo.prov done
   setprop vendor.halo.prov.trigger done
   start halo-init-prov

#Stop all core services before provisioning
on property:vendor.halo.core-services=stop
   stop halo-core-rnp
   stop halo-core-swp
   stop halo-hub-core
   stop halo-logr

on property:vendor.halo.ota.900=start
   mkdir /data/vendor/halo/tmp/dfu 0770 system system
   start halo-otamgr

on property:init.svc.halo-otamgr=stopped
   start halo-ota-exit
   setprop vendor.halo.ota.900 stop
   setprop persist.vendor.halo.ota.900 stopped

on property:vendor.halo.sendlogs=start
   start halo-sendlogs

on property:init.svc.halo-sendlogs=stopped
   setprop vendor.halo.sendlogs stop

on property:init.svc.halo-otamgr=running
   setprop persist.vendor.halo.ota.900 running

#Restart OTA on reboot
on property:vendor.halo.ota.900=none && property:persist.vendor.halo.ota.900=running && property:init.svc.halo-core-rnp=running
   start halo-otamgr

on property:ro.product.device=daredevil && property:vendor.halo.core.reset=true
   setprop sys.powerctl reboot

