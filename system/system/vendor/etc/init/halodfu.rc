#svc dodfuservice: performs halo dfu over all transports.

# dfu parameter
#   app - only app update
#   all - both app and bl update
service dodfuservice /vendor/bin/doDfu.sh /data/vendor/halo/firmware all
   oneshot
   disabled
   user root
   group system inet
   class main

service compare_dfu /vendor/bin/compare_dfu.sh
   oneshot
   disabled
   user root
   group system inet
   class main

service nordiccomm /vendor/bin/nordiccomm.sh
   class main
   user root
   group system inet
   disabled
   oneshot

on post-fs-data
   wait /dev/halo0 60
   chown system system /dev/halo0
   chmod 0660 /dev/halo0
   start nordiccomm
   setprop vendor.halo.nordiccomm.state fs-data

on property:init.svc.nordiccomm=stopped && property:vendor.halo.nordiccomm.state=fs-data
   start halonordicfr

on property:init.svc.halonordicfr=stopped
   start nordiccomm
   setprop vendor.halo.nordiccomm.state nordic-fr

on property:init.svc.nordiccomm=stopped && property:vendor.halo.dfu=none && property:vendor.halo.nordiccomm.state=nordic-fr
   start compare_dfu

on property:init.svc.compare_dfu=stopped && property:vendor.halo.dfu=required
   mkdir /data/vendor/halo/firmware 0777 root system
   copy /vendor/firmware/halo/laser_halo_app.bin /data/vendor/halo/firmware/laser_halo_app.bin
   copy /vendor/firmware/halo/laser_halo_app.dat /data/vendor/halo/firmware/laser_halo_app.dat
   copy /vendor/firmware/halo/laser_sd_bl.bin /data/vendor/halo/firmware/laser_sd_bl.bin
   copy /vendor/firmware/halo/laser_sd_bl.dat /data/vendor/halo/firmware/laser_sd_bl.dat
   #change the ownership of the files
   chown root system /data/vendor/halo/firmware/laser_halo_app.bin
   chown root system /data/vendor/halo/firmware/laser_halo_app.dat
   chown root system /data/vendor/halo/firmware/laser_sd_bl.bin
   chown root system /data/vendor/halo/firmware/laser_sd_bl.dat
   chmod 660 /data/vendor/halo/firmware/laser_halo_app.bin
   chmod 660 /data/vendor/halo/firmware/laser_halo_app.dat
   chmod 660 /data/vendor/halo/firmware/laser_sd_bl.bin
   chmod 660 /data/vendor/halo/firmware/laser_sd_bl.dat
   start dodfuservice

on property:init.svc.dodfuservice=stopped
   start nordiccomm
   setprop vendor.halo.nordiccomm.state do-dfu
   rm /data/vendor/halo/firmware/laser_halo_app.bin
   rm /data/vendor/halo/firmware/laser_halo_app.dat
   rm /data/vendor/halo/firmware/laser_sd_bl.bin
   rm /data/vendor/halo/firmware/laser_sd_bl.dat

on property:init.svc.nordiccomm=stopped && property:vendor.halo.comm=ready && property:init.svc.dodfuservice=stopped
   setprop vendor.halo.ready true

on property:init.svc.nordiccomm=stopped && property:vendor.halo.comm=failed && property:init.svc.dodfuservice=stopped
   setprop vendor.halo.ready true

on property:init.svc.nordiccomm=stopped && property:vendor.halo.dfu=not-required
   setprop vendor.halo.ready true
