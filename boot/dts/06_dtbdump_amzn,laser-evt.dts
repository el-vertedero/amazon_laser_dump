/dts-v1/;

/ {
	compatible = "amzn,laser-evt\0mediatek,mt8512";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Amazon Laser EVT";

	aliases {
		mdp_rdma0 = "/rdma@15007000";
		mdp_rsz0 = "/rsz@15008000";
		mdp_tdshp0 = "/tdshp@15009000";
		mdp_wrot0 = "/wrot@1500a000";
		mdp_gamma0 = "/gamma@1500b000";
		mdp_dth0 = "/dth@1500c000";
		i2c0 = "/i2c@11007000";
		i2c1 = "/i2c@10019000";
		i2c2 = "/i2c-ipi";
		serial0 = "/serial@11002000";
		ringled0 = "/i2c@11007000/lp5036@30";
		ringled1 = "/i2c@11007000/lp5036@31";
	};

	atf_logger {
		compatible = "mediatek,atf_logger";
		interrupts = <0x00 0xc3 0x01>;
	};

	mtcpufreq {
		compatible = "mediatek,mt8512-cpufreq";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		acenna_reserved {
			compatible = "shared-dma-pool";
			size = <0x00 0x8000000>;
			reusable;
			linux,phandle = <0x33>;
			phandle = <0x33>;
		};

		atf-logbuf-memory@42fc0000 {
			compatible = "mediatek,mt8512-atf-logbuf-memory";
			no-map;
			reg = <0x00 0x42fc0000 0x00 0x40000>;
		};

		atf-reserved-memory@43000000 {
			compatible = "mediatek,mt8512-atf-reserved-memory";
			no-map;
			reg = <0x00 0x43000000 0x00 0x30000>;
		};

		ram_console-reserved-memory@44400000 {
			compatible = "mediatek,ram_console";
			reg = <0x00 0x44400000 0x00 0x10000>;
		};

		pstore-reserved-memory@44410000 {
			compatible = "mediatek,pstore";
			reg = <0x00 0x44410000 0x00 0xe0000>;
		};

		minirdump-reserved-memory@444f0000 {
			compatible = "mediatek,minirdump";
			reg = <0x00 0x444f0000 0x00 0x10000>;
		};

		adsp_mem_region {
			compatible = "mediatek,adsp-reserved-memory";
			no-map;
			reg = <0x00 0x56000000 0x00 0xf00000>;
			linux,phandle = <0x0a>;
			phandle = <0x0a>;
		};

		optee-reserved-memory@43030000 {
			compatible = "mediatek,mt8512-optee-reserved-memory";
			no-map;
			reg = <0x00 0x43030000 0x00 0x200000>;
		};

		optee-reserved-shmemory@43230000 {
			compatible = "mediatek,mt8512-optee-reserved-shmemory";
			no-map;
			reg = <0x00 0x43230000 0x00 0x40000>;
		};
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	dummy13m {
		compatible = "fixed-clock";
		clock-frequency = <0xc65d40>;
		#clock-cells = <0x00>;
	};

	dummy32k {
		compatible = "fixed-clock";
		clock-frequency = <0x7d00>;
		#clock-cells = <0x00>;
	};

	oscillator@0 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x18cba80>;
		clock-output-names = "clk26m";
		linux,phandle = <0x14>;
		phandle = <0x14>;
	};

	oscillator@1 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x8000>;
		clock-output-names = "clk32k";
		linux,phandle = <0x08>;
		phandle = <0x08>;
	};

	ice_debug {
		compatible = "mediatek,mt8512-ice_debug\0mediatek,mt2701-ice_debug";
		clocks = <0x02 0x1a>;
		clock-names = "ice_dbg";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x03>;
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
		clock-frequency = <0xc65d40>;
	};

	pmu {
		compatible = "arm,cortex-a7-pmu";
		interrupt-parent = <0x03>;
		interrupts = <0x01 0x07 0x08>;
	};

	interrupt-controller@0c000000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x03>;
		interrupt-parent = <0x03>;
		interrupt-controller;
		reg = <0x00 0xc000000 0x00 0x40000 0x00 0xc080000 0x00 0x200000>;
		interrupts = <0x01 0x09 0xf04>;
		linux,phandle = <0x03>;
		phandle = <0x03>;
	};

	chipid@08000000 {
		compatible = "mediatek,chipid";
		reg = <0x00 0x8000000 0x00 0x04 0x00 0x8000004 0x00 0x04 0x00 0x8000008 0x00 0x04 0x00 0x800000c 0x00 0x04>;
	};

	soc_data@08000000 {
		compatible = "mediatek,mt8512-efuse\0mediatek,efuse";
		reg = <0x00 0x8000000 0x00 0x10>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
	};

	syscon@10000000 {
		compatible = "mediatek,mt8512-topckgen\0syscon";
		reg = <0x00 0x10000000 0x00 0x1000>;
		#clock-cells = <0x01>;
		linux,phandle = <0x04>;
		phandle = <0x04>;
	};

	syscon@10001000 {
		compatible = "mediatek,mt8512-infrasys\0syscon";
		reg = <0x00 0x10001000 0x00 0x1000>;
		#clock-cells = <0x01>;
		#reset-cells = <0x01>;
		linux,phandle = <0x02>;
		phandle = <0x02>;
	};

	syscfg_pctl_a@10005000 {
		compatible = "mediatek,mt8512-pctl-a-syscfg\0syscon";
		reg = <0x00 0x10005000 0x00 0x1000>;
		linux,phandle = <0x09>;
		phandle = <0x09>;
	};

	syscon@10006000 {
		compatible = "mediatek,mt8512-scpsys\0syscon";
		#power-domain-cells = <0x01>;
		reg = <0x00 0x10006000 0x00 0x1000>;
		clocks = <0x04 0x60 0x05 0x0c 0x05 0x0d 0x06 0x04 0x06 0x05 0x06 0x00 0x06 0x06 0x06 0x03 0x06 0x08 0x06 0x01 0x06 0x09 0x06 0x02 0x04 0x73 0x04 0x74 0x04 0x54 0x04 0x76 0x04 0x5f 0x02 0x32 0x04 0x48 0x02 0x1b 0x02 0x1f 0x04 0x71>;
		clock-names = "mm\0mm-0\0mm-1\0ipsys\0ip0-0\0ip0-1\0ip0-2\0ip0-3\0ip1-0\0ip1-1\0ip2-0\0ip2-1\0conn\0conn1\0dsp\0dsp1\0dsp-0\0dsp-1\0audafe\0audafe-0\0audsrc\0usb";
		infracfg = <0x02>;
		smi_comm = <0x07>;
		linux,phandle = <0x0b>;
		phandle = <0x0b>;
	};

	toprgu@10007000 {
		compatible = "mediatek,mt8512-wdt\0mediatek,mt6589-wdt";
		reg = <0x00 0x10007000 0x00 0x1000>;
		interrupts = <0x00 0x39 0x02>;
		registered-in-atf = <0x01>;
		#reset-cells = <0x01>;
	};

	apxgpt@10008000 {
		compatible = "mediatek,mt8512-timer\0mediatek,mt6577-timer";
		reg = <0x00 0x10008000 0x00 0x1000>;
		interrupts = <0x00 0x55 0x08>;
		clocks = <0x04 0x2f 0x08>;
		clock-names = "clk13m\0clk32k";
	};

	gpt_rtc@10008000 {
		compatible = "mediatek,mt8512-gpt-rtc";
		reg = <0x00 0x10008000 0x00 0x1000>;
		interrupts = <0x00 0x73 0x08>;
		gpt-index = <0x05>;
	};

	pinctrl@1000b000 {
		compatible = "mediatek,mt8512-pinctrl";
		reg = <0x00 0x1000b000 0x00 0x1000>;
		mediatek,pctl-regmap = <0x09>;
		pins-are-numbered;
		gpio-controller;
		#gpio-cells = <0x02>;
		interrupt-controller;
		#interrupt-cells = <0x02>;
		interrupts = <0x00 0x56 0x04>;
		pinctrl-names = "default";
		linux,phandle = <0x0d>;
		phandle = <0x0d>;

		mmc1default {
			linux,phandle = <0x29>;
			phandle = <0x29>;

			pins_cmd_dat {
				pinmux = <0x4801 0x4901 0x4a01 0x4b01 0x4601>;
				input-enable;
				drive-strength = <0x06>;
				bias-pull-up = <0x65>;
			};

			pins_clk {
				pinmux = <0x4701>;
				drive-strength = <0x06>;
				bias-pull-down = <0x66>;
			};
		};

		mmc1@0 {
			linux,phandle = <0x2a>;
			phandle = <0x2a>;

			pins_cmd_dat {
				pinmux = <0x4801 0x4901 0x4a01 0x4b01 0x4601>;
				input-enable;
				drive-strength = <0x06>;
				bias-pull-up = <0x65>;
			};

			pins_clk {
				pinmux = <0x4701>;
				drive-strength = <0x06>;
				bias-pull-down = <0x66>;
			};
		};

		mmc1_dat1 {
			linux,phandle = <0x2b>;
			phandle = <0x2b>;

			pins_dat1 {
				pinmux = <0x4901>;
				input-enable;
				drive-strength = <0x06>;
				bias-pull-up = <0x66>;
			};
		};

		dat1_eint {
			linux,phandle = <0x2c>;
			phandle = <0x2c>;

			pins_dat1_eint {
				pinmux = <0x4900>;
				input-enable;
				bias-pull-up = <0x66>;
			};
		};

		gpiodefault {
			linux,phandle = <0x3e>;
			phandle = <0x3e>;

			pins_cmd_dat {
				pinmux = <0x2800 0x2900 0x2b00>;
				bias-disable;
				input-enable;
			};

			pins_cmd_dat1 {
				pinmux = <0x2a00>;
				bias-pull-up;
				input-enable;
			};
		};

		privacydefault {
			linux,phandle = <0x3f>;
			phandle = <0x3f>;
		};

		pwmdefault {
			linux,phandle = <0x11>;
			phandle = <0x11>;

			pins_cmd_dat {
				pinmux = <0xe03>;
			};
		};

		spi {
			linux,phandle = <0x1c>;
			phandle = <0x1c>;

			pins_spi {
				pinmux = <0x7001 0x7101 0x7201 0x7301>;
				bias-disable;
			};
		};

		nandcdefault {

			pins0 {
				pinmux = <0x4c03 0x4d03 0x4e03 0x4f03>;
				input-enable;
			};

			pins1 {
				pinmux = <0x5003 0x5203>;
				bias-pull-up;
			};
		};

		nandchigh {

			pins0 {
				pinmux = <0x4c03 0x4d03 0x4e03 0x4f03>;
				drive-strength = <0x08>;
				input-enable;
			};

			pins1 {
				pinmux = <0x5003 0x5203>;
				drive-strength = <0x08>;
				bias-pull-up;
			};
		};

		usb_iddig_pull_up {

			pins_iddig {
				pinmux = <0x1a01>;
				bias-pull-up;
			};
		};

		usb_iddig_pull_down {

			pins_iddig {
				pinmux = <0x1a01>;
				bias-pull-down;
			};
		};

		usbvbus_det_pins_default {
			linux,phandle = <0x3d>;
			phandle = <0x3d>;

			pins_cmd_dat {
				pinmux = <0x1a00>;
				input-enable;
				bias-disable;
				bias-pull-down;
			};
		};

		adspdefault {
			linux,phandle = <0x0c>;
			phandle = <0x0c>;

			pins_cmd_dat {
				pinmux = <0x1b05 0x1c05 0x1d05 0x1e05 0x1f05>;
			};
		};

		led_pwr_pins {
			linux,phandle = <0x55>;
			phandle = <0x55>;

			pins_fixed_regulator {
				pinmux = <0x2200>;
				bias-pull-up;
			};
		};

		led_hv_en_pins {
			linux,phandle = <0x58>;
			phandle = <0x58>;

			pins_hv_en {
				pinmux = <0x600>;
				output-high;
			};
		};

		rtc_pins {
			linux,phandle = <0x10>;
			phandle = <0x10>;

			pins_irq {
				pinmux = <0x2400>;
				bias-disable;
			};
		};

		eint4 {
			linux,phandle = <0x41>;
			phandle = <0x41>;

			pins_cmd_dat {
				pinmux = <0x1400>;
				input-enable;
				bias-disable;
			};
		};

		audiodefault {
			linux,phandle = <0x48>;
			phandle = <0x48>;

			pins_mclk {
				pinmux = <0x5c02>;
				drive-strength = <0x06>;
			};

			pins_bclk {
				pinmux = <0x6901>;
				drive-strength = <0x06>;
			};

			pins_cmd_dat {
				pinmux = <0x5802 0x5902 0x5a02 0x5b02 0x6002 0x6102 0x6202 0x6a01 0x6c01 0x6d01>;
			};
		};

		audlinemutehigh {
			linux,phandle = <0x49>;
			phandle = <0x49>;

			pins_cmd_dat {
				pinmux = <0xa00>;
				output-high;
			};
		};

		audlinemutelow {
			linux,phandle = <0x4a>;
			phandle = <0x4a>;

			pins_cmd_dat {
				pinmux = <0xa00>;
				output-low;
			};
		};

		audlineouthigh {
			linux,phandle = <0x4b>;
			phandle = <0x4b>;

			pins_cmd_dat {
				pinmux = <0xb00>;
				output-high;
			};
		};

		audlineinlow {
			linux,phandle = <0x4c>;
			phandle = <0x4c>;

			pins_cmd_dat {
				pinmux = <0xb00>;
				output-low;
			};
		};

		audlineinpwrhigh {
			linux,phandle = <0x4d>;
			phandle = <0x4d>;

			pins_cmd_dat {
				pinmux = <0x2100>;
				output-high;
			};
		};

		audlineinpwrlow {
			linux,phandle = <0x4e>;
			phandle = <0x4e>;

			pins_cmd_dat {
				pinmux = <0x2100>;
				output-low;
			};
		};

		audlineoutenabhigh {
			linux,phandle = <0x4f>;
			phandle = <0x4f>;

			pins_cmd_dat {
				pinmux = <0x5e00>;
				output-high;
			};
		};

		audlineoutenablow {
			linux,phandle = <0x50>;
			phandle = <0x50>;

			pins_cmd_dat {
				pinmux = <0x5e00>;
				output-low;
			};
		};

		audlineoutgainhigh {
			linux,phandle = <0x51>;
			phandle = <0x51>;

			pins_cmd_dat {
				pinmux = <0x5d00>;
				output-high;
			};
		};

		audlineoutgainlow {
			linux,phandle = <0x52>;
			phandle = <0x52>;

			pins_cmd_dat {
				pinmux = <0x5d00>;
				output-low;
			};
		};

		audspkrpwrhigh {
			linux,phandle = <0x53>;
			phandle = <0x53>;

			pins_cmd_dat {
				pinmux = <0x6b00>;
				output-high;
			};
		};

		audspkrpwrlow {
			linux,phandle = <0x54>;
			phandle = <0x54>;

			pins_cmd_dat {
				pinmux = <0x6b00>;
				output-low;
			};
		};

		uart1default {
			linux,phandle = <0x17>;
			phandle = <0x17>;

			pins_rx {
				pinmux = <0x3601>;
				input-enable;
				bias-pull-up;
			};

			pins_tx {
				pinmux = <0x3701>;
			};

			pins_rts {
				pinmux = <0x3901>;
			};

			pins_cts {
				pinmux = <0x3801>;
			};
		};

		uart1sleep {
			linux,phandle = <0x18>;
			phandle = <0x18>;

			pins_rx {
				pinmux = <0x3601>;
				input-enable;
				bias-pull-up;
			};

			pins_tx {
				pinmux = <0x3701>;
			};

			pins_rts {
				pinmux = <0x3900>;
				output-high;
			};

			pins_cts {
				pinmux = <0x3801>;
				input-enable;
				bias-pull-up;
			};
		};

		buck_sec_3v3_en_pins {
			linux,phandle = <0x56>;
			phandle = <0x56>;

			pins_fixed_regulator {
				pinmux = <0x2000>;
				input-enable;
				bias-disable;
			};
		};

		xltr_en_pins {
			linux,phandle = <0x57>;
			phandle = <0x57>;

			pins_fixed_regulator {
				pinmux = <0x1500>;
				bias-disable;
			};
		};

		pinctrl_halo {
			linux,phandle = <0x1b>;
			phandle = <0x1b>;

			pins_int {
				pinmux = <0x6700>;
				input-enable;
				bias-disable;
			};

			pins_reset {
				pinmux = <0x2d00>;
				input-enable;
				bias-disable;
			};
		};

		mmc0default {
			linux,phandle = <0x24>;
			phandle = <0x24>;

			pins_clk {
				pinmux = <0x5201>;
				bias-pull-down;
			};

			pins_cmd_dat {
				pinmux = <0x5601 0x5501 0x5401 0x5301 0x4f01 0x4e01 0x4d01 0x4c01 0x5101>;
				input-enable;
				bias-pull-up;
			};

			pins_rst {
				pinmux = <0x5001>;
				bias-pull-up;
			};
		};

		mmc0 {
			linux,phandle = <0x25>;
			phandle = <0x25>;

			pins_clk {
				pinmux = <0x5201>;
				drive-strength = <0x06>;
				bias-pull-down = <0x65>;
			};

			pins_cmd_dat {
				pinmux = <0x5601 0x5501 0x5401 0x5301 0x4f01 0x4e01 0x4d01 0x4c01 0x5101>;
				input-enable;
				drive-strength = <0x06>;
				bias-pull-up = <0x65>;
			};

			pins_rst {
				pinmux = <0x5001>;
				bias-pull-up;
			};
		};

		mmc0sleep {
			linux,phandle = <0x26>;
			phandle = <0x26>;

			pins_clk {
				pinmux = <0x5200>;
				bias-disable;
				input-disable;
			};

			pins_cmd_dat {
				pinmux = <0x5600 0x5500 0x5400 0x5300 0x4f00 0x4e00 0x4d00 0x4c00 0x5100>;
				bias-disable;
				input-disable;
			};

			pins_rst {
				pinmux = <0x5000>;
				bias-disable;
				input-disable;
			};
		};

		sirq_pin {
			linux,phandle = <0x59>;
			phandle = <0x59>;

			pins_dat {
				pinmux = <0x6f00>;
				input-enable;
				bias-disable;
			};
		};

		zigbee {
			linux,phandle = <0x1d>;
			phandle = <0x1d>;

			pins_int {
				pinmux = <0x6800>;
				input-enable;
				bias-disable;
			};

			pins_rst {
				pinmux = <0x6500>;
				bias-disable;
			};
		};
	};

	syscon@1000c000 {
		compatible = "mediatek,mt8512-apmixedsys\0syscon";
		reg = <0x00 0x1000c000 0x00 0x1000>;
		#clock-cells = <0x01>;
		linux,phandle = <0x1f>;
		phandle = <0x1f>;
	};

	keypad@10010000 {
		compatible = "mediatek,kp";
		reg = <0x00 0x10010000 0x00 0x1000>;
		interrupts = <0x00 0x7e 0x02>;
	};

	dvfsrc@10012000 {
		compatible = "mediatek,dvfsrc";
		reg = <0x00 0x10012000 0x00 0x1000 0x00 0x110780 0x00 0x80 0x00 0x10006000 0x00 0x1000>;
		clocks = <0x02 0x14>;
		clock-names = "dvfsrc";
		status = "disabled";
	};

	adsp@10018000 {
		compatible = "mediatek,mt8512-audio_dsp";
		reg = <0x00 0x10018000 0x00 0x1000 0x00 0x110000 0x00 0x40000>;
		reg-names = "cfg\0sram";
		interrupts = <0x00 0x81 0x04 0x00 0x80 0x08>;
		interrupts-name = "ipi\0wdt";
		clocks = <0x04 0x54 0x04 0x2e 0x04 0x76 0x04 0x75 0x02 0x32 0x02 0x0d 0x04 0x5f>;
		clock-names = "dsp_sel\0clk26m_ck\0dsp_26m\0dsp_32k\0infra_dsp_axi\0infra_dsp_uart\0sram_sel";
		memory-region = <0x0a>;
		power-domains = <0x0b 0x06>;
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <0x0c>;
