			phandle = <0x3a>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x34 0x35 0x36>;
			clocks = <0x37 0x00 0x04 0x0e 0x1f 0x00>;
			clock-names = "cpu\0intermediate\0armpll";
