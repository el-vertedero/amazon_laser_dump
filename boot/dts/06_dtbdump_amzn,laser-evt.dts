				busy-cost-data = <0x00 0x00>;
				idle-cost-data = <0x00>;
			};

			mt8512-cluster-cost0 {
				busy-cost-data = <0x00 0x00>;
				idle-cost-data = <0x00>;
			};
		};

		idle-states {
			entry-method = "psci";

			mcdi-cpu {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x10001>;
				entry-latency-us = <0x12c>;
				exit-latency-us = <0xc8>;
				min-residency-us = <0x3e8>;
				linux,phandle = <0x34>;
				phandle = <0x34>;
			};

			mcdi-cluster {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x1010001>;
				entry-latency-us = <0x15e>;
				exit-latency-us = <0xfa>;
				min-residency-us = <0x4b0>;
				linux,phandle = <0x35>;
				phandle = <0x35>;
			};

			dpidle {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x1010004>;
				entry-latency-us = <0x12c>;
				exit-latency-us = <0x5dc>;
				min-residency-us = <0xfa0>;
				linux,phandle = <0x36>;
				phandle = <0x36>;
			};
		};
	};

